{
  "name": "le prefixe d'un autre flux ne dispense pas du sien",
  "fn": "ics.scopedEvent",
  "input": {
    "source": {
      "type": "ical",
      "id": "school",
      "name": "School",
      "url": "https://example.test/calendar.ics",
      "color": "#89b4fa",
      "directory": "School"
    },
    "event": {
      "title": "Cours",
      "type": "single",
      "date": "2026-08-28",
      "endDate": null,
      "allDay": true,
      "id": "ical::autre::abc"
    },
    "index": 0
  },
  "expected": {
    "title": "Cours",
    "id": "ical::school::ical::autre::abc",
    "allDay": true,
    "type": "single",
    "date": "2026-08-28",
    "endDate": null
  }
}

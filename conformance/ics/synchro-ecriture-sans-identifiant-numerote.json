{
  "name": "un evenement sans identifiant recoit event-<rang> dans l'espace de l'abonnement",
  "fn": "ics.planNoteSync",
  "input": {
    "source": {
      "type": "ical",
      "id": "school",
      "name": "School",
      "url": "https://example.test/calendar.ics",
      "color": "#89b4fa",
      "directory": "School"
    },
    "remoteEvents": [
      {
        "title": "Un",
        "type": "single",
        "date": "2026-08-28",
        "endDate": null,
        "allDay": true
      },
      {
        "title": "Deux",
        "type": "single",
        "date": "2026-08-29",
        "endDate": null,
        "allDay": true
      }
    ],
    "existingRecords": []

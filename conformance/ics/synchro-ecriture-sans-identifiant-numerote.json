      "fileName": "2026-08-28 Un.md",
      "contents": "---\ntitle: \"Un\"\nid: \"ical::school::event-0\"\nallDay: true\ntype: \"single\"\ndate: \"2026-08-28\"\nendDate: null\n---\n"
    },
    {
      "event": {
        "title": "Deux",
        "allDay": true,
        "type": "single",
        "date": "2026-08-29",
        "endDate": null,
        "id": "ical::school::event-1"
      },
      "calendarId": "ical::school",
      "calendarPath": "School",
      "fileName": "2026-08-29 Deux.md",
      "contents": "---\ntitle: \"Deux\"\nid: \"ical::school::event-1\"\nallDay: true\ntype: \"single\"\ndate: \"2026-08-29\"\nendDate: null\n---\n"
    }
  ]
}

{
    "name": "neo-calendar-desktop",
    "version": "1.73.4",
    "description": "Neo Calendar standalone desktop application",
    "scripts": {
        "dev": "npm --prefix apps/windows run tauri -- dev",
        "build": "npm --prefix apps/windows run build",
        "tauri": "npm --prefix apps/windows run tauri --",
        "package": "npm --prefix apps/windows run tauri",
        "test": "jest && node --test scripts/*.test.mjs && npm --prefix apps/windows run test:packaging",
        "version:set": "node scripts/set-version.mjs",
        "version:patch": "node scripts/set-version.mjs patch",
        "version:minor": "node scripts/set-version.mjs minor",
        "version:major": "node scripts/set-version.mjs major",
        "lint": "prettier --check \"src/**/*.ts*\" \"apps/windows/src/**/*.ts*\"",
        "fix-lint": "prettier --write \"src/**/*.ts*\" \"apps/windows/src/**/*.ts*\"",
        "android:build": "npm --prefix apps/android run android:build",
        "android:frontend": "npm --prefix apps/android run build",
        "wallpapers": "node scripts/build-wallpapers.mjs"
    },
    "keywords": [],
    "author": {
        "name": "Ahmed"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/co": "^4.6.3",
        "@types/color": "^3.0.3",
        "@types/dav": "^1.7.4",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^2.0.9",
        "@types/node": "^16.11.6",
        "@types/react": "^17.0.38",
        "@types/react-dom": "^17.0.11",
        "builtin-modules": "^3.2.0",
        "date-holidays": "^3.33.0",
        "esbuild": "^0.28.1",
        "fast-check": "^3.8.0",
        "husky": "^7.0.4",
        "jest": "^29.3.1",
        "jest-environment-jsdom": "^29.7.0",
        "obsidian": "^0.16.3",
        "prettier": "^2.5.1",
        "sharp": "^0.35.3",
        "ts-jest": "^29.4.11",
        "tslib": "2.3.1",
        "typescript": "^6.0.2",
        "zod-fast-check": "^0.9.0"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/utilities": "^3.2.2",
        "@types/deep-equal": "^1.0.1",
        "@types/ical": "^0.8.0",
        "chrono-node": "^2.9.0",
        "color": "^4.2.1",
        "dav": "^1.8.0",
        "deep-equal": "^2.1.0",
        "ical": "^0.8.0",
        "ical.js": "^1.5.0",
        "lucide-react": "^1.28.0",
        "luxon": "^2.3.0",
        "moment": "^2.29.4",
        "obsidian-daily-notes-interface": "^0.9.4",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "rrule": "^2.7.2",
        "zod": "^3.21.4"
    },
    "overrides": {
        "zod-fast-check": {
            "fast-check": "$fast-check"
        }
    },
    "private": true
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus. Le dossier d'état du moteur (clé, certificat, secrets, index) ne quitte jamais le téléphone : une restauration
     sur un autre téléphone dupliquerait l'identité de l'appareil Syncthing. La copie des notes lues (`note-cache.bin`) est
     reconstruite à volonté : elle ne voyage pas non plus. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="syncthing/" />
        <exclude domain="file" path="note-cache.bin" />
        <exclude domain="file" path="note-cache.bin.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="syncthing/" />
        <exclude domain="file" path="note-cache.bin" />
        <exclude domain="file" path="note-cache.bin.tmp" />
    </device-transfer>
</data-extraction-rules>

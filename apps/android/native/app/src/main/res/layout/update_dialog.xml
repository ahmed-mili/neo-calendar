<?xml version="1.0" encoding="utf-8"?>
<!-- Le popup de mise a jour, aux couleurs de l'app.

     Une marge laterale sur la racine plutot que sur la fenetre : le fond de la
     fenetre est efface (voir showPrompt), donc c'est cette vue qui porte la
     carte, et sans marge elle toucherait les bords de l'ecran. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:orientation="vertical"
    android:background="@drawable/update_dialog_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_available"
        android:textColor="#CDD6F4"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/update_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#A6ADC8"
        android:textSize="14sp"
        android:lineSpacingExtra="4sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/update_later"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/update_btn_ghost"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/update_later"
            android:textAllCaps="false"
            android:textColor="#A6ADC8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/update_install"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/update_btn_primary"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/update_install"
            android:textAllCaps="false"
            android:textColor="#11111B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The widget: a rounded card, a scrolling list of the next events, and one
     button to add one. Resizing the widget simply shows more of the list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/widget_empty_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13.7sp"
            android:textStyle="bold"
            android:textColor="#E6E9F5" />

        <TextView
            android:id="@+id/widget_empty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textColor="#9AA0B4" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/widget_add_background"
        android:contentDescription="@string/widget_add"
        android:padding="12dp"
        android:src="@drawable/widget_add" />
</FrameLayout>

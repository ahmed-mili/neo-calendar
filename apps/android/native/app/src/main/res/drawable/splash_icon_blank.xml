<?xml version="1.0" encoding="utf-8"?>
<!-- Icône invisible de l'écran de démarrage système : il n'est qu'un aplat de couleur, le rond de chargement de l'app prend le relais (NativeScreen).
     Un vecteur vide serait pris pour « pas d'icône » et Android 12 remettrait l'icône du lanceur : d'où une forme transparente. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="24dp" android:height="24dp" />
    <solid android:color="#00000000" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
    The icon for the system splash screen.

    Android draws it inside a fixed circle and only shows the middle third of
    whatever it is given, so the launcher icon — barely insetted, since a home
    screen masks it anyway — arrives filling the whole area and reads as
    enormous. This one keeps the safe margin the splash screen expects.

    It also takes the faded-edge bitmap rather than the launcher one: nothing
    masks the icon here, so an opaque square would cut a hard edge into the
    splash background.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_icon_image"
    android:inset="30%" />

<?xml version="1.0" encoding="utf-8"?>
<!-- An all-day event wears a dot rather than a bar: it spans no hours, so
     there is no length to draw. White, tinted per row like the bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFF" />
</shape>

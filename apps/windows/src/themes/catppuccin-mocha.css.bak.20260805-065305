.nc-theme-catppuccin-mocha,
:root {
    --background-primary: rgb(30, 30, 46);
    --background-secondary: rgb(24, 24, 37);
    --background-modifier-hover: rgb(49, 50, 68);
    --background-modifier-border: rgba(108, 112, 134, 0.28);
    --background-modifier-border-hover: rgba(137, 180, 250, 0.46);
    --text-normal: rgb(198, 208, 245);
    --text-muted: rgb(161, 168, 201);
    --text-faint: rgb(105, 109, 134);
    --text-on-accent: rgb(30, 30, 46);
    --text-error: rgb(243, 139, 168);
    --interactive-accent: #658ff2;
}

.nc-theme-catppuccin-mocha {
    color-scheme: dark;
    --nc-bg-primary: rgb(30, 30, 46);
    --nc-bg-secondary: rgb(24, 24, 37);
    --nc-bg-crust: rgb(17, 17, 27);
    --nc-surface: rgba(30, 30, 46, 0.75);
    --nc-surface-hover: rgb(49, 50, 68);
    --nc-text-primary: rgb(198, 208, 245);
    --nc-text-secondary: rgb(161, 168, 201);
    --nc-text-faint: rgb(105, 109, 134);
    --nc-border: transparent;
    --nc-accent: #658ff2;
    --nc-accent-strong: #89b4fa;
    --nc-accent-text: rgb(30, 30, 46);
    --nc-danger: rgb(243, 139, 168);
    --nc-success: rgb(166, 227, 161);
    --nc-ui-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
    --nc-code-font: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
    --nc-theme-surface: #1e1e2e;
    --nc-theme-ink: #c6d0f5;
    --nc-theme-accent: #658ff2;
    --nc-card-radius: 22px;
    --nc-font-size: 13px;
    --nc-shadow: 0 8px 24px rgba(17, 17, 27, 0.32);
    --nc-wallpaper-overlay: linear-gradient(
        rgba(13, 15, 28, 0.46),
        rgba(13, 15, 28, 0.46)
    );
    --nc-wallpaper: url("/themes/catppuccin-mocha/mountain-sunset.jpg");
}

{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Neo Calendar",
    "version": "1.0.0",
    "identifier": "com.ahmed.neocalendar",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Neo Calendar",
                "width": 1440,
                "height": 900,
                "minWidth": 960,
                "minHeight": 640
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "msi"]
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["neo-calendar"]
            }
        }
    }
}
